          "employee_code",
          "full_name",
          "store_id",
          "roles",
          "permissions",
          "authenticated_at",
          "offline"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "TaxComponentOut": {
        "additionalProperties": false,
