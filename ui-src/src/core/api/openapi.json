        "required": [
          "cart_id",
          "lines",
          "item_count",
          "subtotal",
          "discount_total",
          "tax_total",
          "total_before_rounding",
          "tax_breakdown",
          "paid",
          "outstanding",
          "rounding_adjustment",
          "settled"
        ],
        "title": "CartOut",
        "type": "object"
      },
      "ChangeQuantityRequest": {
        "additionalProperties": false,
        "properties": {
          "qty_milli": {
            "title": "Qty Milli",
            "type": "integer"
          }
        },
        "required": [
          "qty_milli"
        ],
        "title": "ChangeQuantityRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "The startup gate the splash polls. Unauthenticated by design.",
        "properties": {
          "cloud_configured": {
            "description": "False when no Supabase project is configured (offline dev)",
            "title": "Cloud Configured",
            "type": "boolean"
          },
          "expected_schema_version": {
            "description": "Schema version this build ships",
            "title": "Expected Schema Version",
            "type": "integer"
          },
          "migrations_pending": {
            "title": "Migrations Pending",
            "type": "boolean"
          },
          "schema_version": {
            "description": "Applied SQLite user_version",
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "description": "'ready' once migrations have been applied",
            "title": "Status",
            "type": "string"
          },
          "store_code": {
            "title": "Store Code",
            "type": "string"
          },
          "terminal_code": {
            "title": "Terminal Code",
            "type": "string"
          },
          "version": {
            "description": "Application version",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "schema_version",
          "expected_schema_version",
          "migrations_pending",
          "store_code",
          "terminal_code",
          "cloud_configured"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "employee_code": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Employee Code",
            "type": "string"
          },
          "pin": {
            "maxLength": 12,
            "minLength": 4,
            "title": "Pin",
            "type": "string"
          }
        },
        "required": [
          "employee_code",
          "pin"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LookupResponse": {
        "additionalProperties": false,
        "description": "A parsed scan. `product` is null when the code resolved to nothing.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "is_case": {
            "default": false,
            "title": "Is Case",
            "type": "boolean"
          },
          "product": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProductOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty_milli": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qty Milli"
          },
          "raw": {
            "title": "Raw",
            "type": "string"
          },
          "resolved": {
            "title": "Resolved",
            "type": "boolean"
          },
          "symbology": {
            "title": "Symbology",
            "type": "string"
          }
        },
        "required": [
          "raw",
          "symbology",
          "resolved"
        ],
        "title": "LookupResponse",
        "type": "object"
      },
      "MoneyOut": {
        "additionalProperties": false,
        "description": "An amount, as both the canonical integer and something to display.\n\n`paise` is the truth; `text` is pre-formatted so the UI never reimplements\ncurrency formatting and cannot drift from what the receipt prints.\nFormatting is presentation, not math \u2014 React still does no arithmetic\n(architecture \u00a71.2).",
        "properties": {
          "paise": {
            "title": "Paise",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "paise",
          "text"
        ],
        "title": "MoneyOut",
        "type": "object"
      },
      "PostSaleResponse": {
        "additionalProperties": false,
        "properties": {
          "change_due": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "grand_total": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "receipt_html": {
            "title": "Receipt Html",
            "type": "string"
          },
          "receipt_no": {
            "title": "Receipt No",
            "type": "string"
          },
          "receipt_text": {
            "title": "Receipt Text",
            "type": "string"
          },
          "rounding_adjustment": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "sale_id": {
            "title": "Sale Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
