            "$ref": "#/components/schemas/MoneyOut"
          },
          "settled": {
            "title": "Settled",
            "type": "boolean"
          },
          "subtotal": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "tax_breakdown": {
            "items": {
              "$ref": "#/components/schemas/TaxComponentOut"
            },
            "title": "Tax Breakdown",
            "type": "array"
          },
          "tax_total": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "total_before_rounding": {
            "$ref": "#/components/schemas/MoneyOut"
          }
