{
  "components": {
    "schemas": {
      "AddLineRequest": {
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barcode"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "qty_milli": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Integer thousandths; 1.250 kg is 1250",
            "title": "Qty Milli"
          }
        },
        "title": "AddLineRequest",
        "type": "object"
      },
      "CartLineOut": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "discount": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "line_no": {
            "title": "Line No",
            "type": "integer"
          },
          "line_total": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "qty_milli": {
            "title": "Qty Milli",
            "type": "integer"
          },
          "quantity_text": {
            "title": "Quantity Text",
            "type": "string"
          },
          "tax_amount": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "unit_price": {
            "$ref": "#/components/schemas/MoneyOut"
          }
        },
        "required": [
          "line_no",
          "product_id",
          "description",
          "qty_milli",
          "quantity_text",
          "unit_price",
          "discount",
          "tax_amount",
          "line_total"
        ],
        "title": "CartLineOut",
        "type": "object"
      },
      "CartOut": {
        "additionalProperties": false,
