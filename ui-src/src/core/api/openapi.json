            "$ref": "#/components/schemas/MoneyOut"
          },
          "tax_amount": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "tax_code": {
            "title": "Tax Code",
            "type": "string"
          },
          "taxable_base": {
            "$ref": "#/components/schemas/MoneyOut"
          }
        },
        "required": [
          "tax_code",
          "rate_bp",
          "taxable_base",
          "tax_amount",
          "cgst",
          "sgst"
        ],
        "title": "TaxComponentOut",
        "type": "object"
      },
      "TenderQuote": {
        "additionalProperties": false,
        "description": "What a method would collect, before the cashier commits to it.",
        "properties": {
          "collected": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "outstanding": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "rounding_adjustment": {
            "$ref": "#/components/schemas/MoneyOut"
          }
        },
        "required": [
          "method",
          "outstanding",
          "collected",
          "rounding_adjustment"
        ],
        "title": "TenderQuote",
        "type": "object"
      },
      "TenderRequest": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "description": "cash (phase 3); upi arrives in phase 4",
            "title": "Method",
            "type": "string"
          },
          "tendered_paise": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cash handed over, when more than is owed",
            "title": "Tendered Paise"
          }
        },
        "required": [
          "method"
        ],
        "title": "TenderRequest",
        "type": "object"
      },
      "TenderResponse": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "title": "Attempt Id",
            "type": "string"
          },
          "cart": {
            "$ref": "#/components/schemas/CartOut"
          },
          "change_due": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
