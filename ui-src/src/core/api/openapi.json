          "receipt_no",
          "status",
          "grand_total",
          "rounding_adjustment",
          "change_due",
          "receipt_html",
          "receipt_text"
        ],
        "title": "PostSaleResponse",
        "type": "object"
      },
      "ProductOut": {
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barcode"
          },
          "is_weighed": {
            "title": "Is Weighed",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pack_size": {
            "default": 1,
            "title": "Pack Size",
            "type": "integer"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "rate_bp": {
            "title": "Rate Bp",
            "type": "integer"
          },
          "short_name": {
            "title": "Short Name",
            "type": "string"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "tax_code": {
            "title": "Tax Code",
            "type": "string"
          },
          "unit_price": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "uom": {
            "title": "Uom",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "sku",
          "name",
          "short_name",
          "uom",
          "is_weighed",
          "tax_code",
          "rate_bp",
          "unit_price"
        ],
        "title": "ProductOut",
        "type": "object"
      },
      "ReceiptPdfResponse": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "receipt_no": {
            "title": "Receipt No",
            "type": "string"
          },
          "sale_id": {
            "title": "Sale Id",
            "type": "string"
          }
        },
        "required": [
