# Copy to .env. Never commit .env.
# The service_role key is deliberately absent — architecture §1.7 forbids bundling it.

POS_SUPABASE_URL=https://your-project.supabase.co
POS_SUPABASE_ANON_KEY=your-anon-key

# Identity of this terminal. Receipt numbers are {STORE}-{TERMINAL}-{SEQ}.
POS_STORE_CODE=ST01
POS_TERMINAL_CODE=T1

# The server's UUID for this till (public.terminals.id). Sales queue locally
# without it and refuse to push, because the cloud cannot attribute a sale to
# a machine it has never heard of. The demo seed uses the value below.
POS_TERMINAL_ID=018f0000-0000-7000-8000-000000000200

# Where the local SQLite database lives. Defaults to %PROGRAMDATA%\RetailPOS
# on Windows so that updates never touch it (architecture §14).
# POS_DATA_DIR=

# Set to 1 to allow the shell to run without a Supabase project (offline dev).
POS_ALLOW_OFFLINE_BOOTSTRAP=1
